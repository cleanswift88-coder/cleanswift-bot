{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ],
  "env": {
    "PAGE_ACCESS_TOKEN": "@page_access_token",
    "WHATSAPP_TOKEN": "@whatsapp_token",
    "PHONE_NUMBER_ID": "@phone_number_id"
  }
}
