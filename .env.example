# CleanSwift Bot — Variables d'environnement
# Copie ce fichier en .env et remplis les valeurs

# Depuis Facebook Developer → Messenger → Token d'accès
PAGE_ACCESS_TOKEN=ton_page_access_token_ici

# Depuis Facebook Developer → WhatsApp → Token
WHATSAPP_TOKEN=ton_whatsapp_token_ici

# Depuis Facebook Developer → WhatsApp → Phone Number ID
PHONE_NUMBER_ID=ton_phone_number_id_ici

# Token de vérification — garde cette valeur exacte
VERIFY_TOKEN=cleanswift_bot_2026

PORT=3000
